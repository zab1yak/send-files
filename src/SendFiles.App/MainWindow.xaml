<Window x:Class="SendFiles.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SendFiles.App.ViewModels"
        xmlns:res="clr-namespace:SendFiles.App.Resources"
        xmlns:icons="clr-namespace:SendFiles.App.Icons"
        Title="{x:Static res:Strings.AppName}"
        Width="392" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" ShowInTaskbar="True">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <!-- Margin leaves room for the soft shadow outside the rounded card. -->
  <Border x:Name="Card" Margin="20" CornerRadius="22"
          Background="{DynamicResource Brush.Window.Background}"
          BorderBrush="{DynamicResource Brush.Window.Border}" BorderThickness="1"
          MouseLeftButtonDown="OnCardMouseDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32"
                        Color="{StaticResource Color.Shadow}" RenderingBias="Performance" />
    </Border.Effect>

    <Grid Margin="20,14,20,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <DockPanel Grid.Row="0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Tag="{x:Static icons:LucideIcons.Minus}"
                  AutomationProperties.Name="{x:Static res:Strings.Window_Minimize}"
                  ToolTip="{x:Static res:Strings.Window_Minimize}" Click="OnMinimize" />
          <Button Style="{StaticResource IconButton}" Tag="{x:Static icons:LucideIcons.X}" Margin="4,0,0,0"
                  AutomationProperties.Name="{x:Static res:Strings.Window_Close}"
                  ToolTip="{x:Static res:Strings.Window_Close}" Click="OnClose" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Secondary}" FontWeight="SemiBold" VerticalAlignment="Center"
                   Text="{x:Static res:Strings.AppName}" />
      </DockPanel>

      <!-- QR or problem state -->
      <Grid Grid.Row="1" Margin="0,18,0,0" Width="248" Height="248" HorizontalAlignment="Center">
        <Border CornerRadius="22" Background="{DynamicResource Brush.Qr.Background}" Padding="18"
                Visibility="{Binding HasQr, Converter={StaticResource BoolToVisibility}}">
          <Path Data="{Binding QrGeometry}" Fill="{DynamicResource Brush.Qr.Foreground}" Stretch="Uniform"
                SnapsToDevicePixels="True" RenderOptions.EdgeMode="Aliased"
                AutomationProperties.Name="{x:Static res:Strings.Qr_Name}" />
        </Border>

        <Border x:Name="ProblemPanel" CornerRadius="22" Background="{DynamicResource Brush.Surface}" Padding="22"
                Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center">
            <Path Width="34" Height="34" Style="{StaticResource Glyph}" Data="{x:Static icons:LucideIcons.WifiOff}"
                  Stroke="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" TextWrapping="Wrap"
                       TextAlignment="Center" LineHeight="18" Text="{Binding HintText}" />
            <Button Style="{StaticResource PillButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                    Command="{Binding RetryCommand}" Content="{x:Static res:Strings.Retry}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Computer name + status -->
      <TextBlock Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource Text.Title}" HorizontalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Text="{Binding ComputerName}" />

      <StackPanel Grid.Row="3" Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Grid Width="10" Height="10" Margin="0,1,8,0" VerticalAlignment="Center">
          <Ellipse x:Name="PulseRing" Fill="{DynamicResource Brush.Status.Ok}" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
              <ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="StatusDot" Fill="{DynamicResource Brush.Status.Ok}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" Text="{Binding StatusText}" />
      </StackPanel>

      <!-- Address -->
      <StackPanel x:Name="AddressPanel" Grid.Row="4" Margin="0,18,0,0" HorizontalAlignment="Center"
                  Visibility="{Binding HasQr, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" HorizontalAlignment="Center"
                   Text="{x:Static res:Strings.ScanHint}" />
        <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,8"
                   Foreground="{DynamicResource Brush.Text.Tertiary}" Text="{x:Static res:Strings.AddressHint}" />
        <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Center" Command="{Binding CopyAddressCommand}"
                AutomationProperties.Name="{x:Static res:Strings.CopyAddress}" ToolTip="{x:Static res:Strings.CopyAddress}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Base}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                       VerticalAlignment="Center" Text="{Binding AddressText}" />
            <Path x:Name="CopyGlyph" Width="13" Height="13" Margin="10,0,0,0" Style="{StaticResource Glyph}"
                  Data="{x:Static icons:LucideIcons.Copy}" Stroke="{DynamicResource Brush.Text.Secondary}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Drop zone (sending is wired up in task 4) -->
      <Border Grid.Row="5" Margin="0,20,0,0" MinHeight="64" CornerRadius="16"
              Background="{DynamicResource Brush.Surface}">
        <Grid>
          <Rectangle RadiusX="16" RadiusY="16" StrokeDashArray="4 3" StrokeThickness="1.25"
                     Stroke="{DynamicResource Brush.Separator}" />
          <TextBlock Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="20,12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"
                     Text="{x:Static res:Strings.DropHint}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
